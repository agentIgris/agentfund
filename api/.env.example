# ─────────────────────────────────────────────────────────────
# @agentfund/api — service-specific environment variables.
# Shared platform-wide vars (SOLANA_CLUSTER, SOLANA_RPC_URL, HELIUS_*,
# PINATA_JWT, DATABASE_URL, REDIS_URL, JWT_SECRET, REGISTRY_PROGRAM_ID,
# ESCROW_PROGRAM_ID, REPUTATION_PROGRAM_ID, PLATFORM_WALLET_KEYPAIR_PATH)
# live in the repo-root .env.example — copy that one too.
# ─────────────────────────────────────────────────────────────

# --- HTTP server ---
HOST=0.0.0.0
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# --- CORS ---
CORS_ORIGIN=*

# --- Auth ---
# JWT lifetime in seconds (spec: 1h)
JWT_EXPIRES_IN=3600
# Auth challenge nonce TTL in seconds (spec: 5 min), Redis-backed + single-use
AUTH_CHALLENGE_TTL_SECONDS=300

# --- Rate limiting (spec: 100 req/min per wallet/IP) ---
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# --- Webhooks (agent-registered callback delivery) ---
# HMAC secret used to sign the X-AgentFund-Signature header on webhook
# deliveries. Falls back to JWT_SECRET if unset.
WEBHOOK_SIGNING_SECRET=
WEBHOOK_DELIVERY_QUEUE_NAME=webhook-delivery
WEBHOOK_MAX_ATTEMPTS=5

# --- Helius webhook receiver ---
# Path Helius POSTs PROGRAM_INSTRUCTION notifications to (mounted under
# this API). Must match the webhook configured in the Helius dashboard.
HELIUS_WEBHOOK_PATH=/indexer/helius-webhook

# --- Optional SVS action authorization for x402 settlement ---
# When enabled, AgentFund broadcasts only an exact transaction that has current
# SVS agent certification, policy approval, simulation, fee, and wallet approval.
SVS_X402_ENFORCE=false
SVS_SERVER_URL=https://app.svsprotocol.com
SVS_RELAYER_BOT_ID=agentfund-relayer
SVS_RELAYER_API_KEY=
SVS_RELAYER_REQUEST_SIGNING_SECRET=
SVS_X402_POLICY_ID=agentfund-x402-contribution-v1
SVS_X402_APPROVAL_STALE_AFTER_MS=900000
SVS_CERTIFICATION_STALE_AFTER_MS=86400000
