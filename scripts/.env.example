# ─────────────────────────────────────────────────────────────
# scripts/ — environment variables specific to one-off ops scripts
# (currently: seed-first-campaign.ts). Shared platform-wide vars
# (SOLANA_CLUSTER, SOLANA_RPC_URL, API_BASE_URL,
# PLATFORM_WALLET_KEYPAIR_PATH, ...) live in the repo-root .env.example —
# copy that one too; this file only adds vars this directory introduces.
# ─────────────────────────────────────────────────────────────

# --- Used to print the human-facing project URL after seeding ---
FRONTEND_BASE_URL=https://predictbgmi.fun

# --- Used to print block-explorer links for seeded transactions ---
SOLSCAN_BASE_URL=https://solscan.io
