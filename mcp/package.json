{
  "name": "@agentfund/mcp",
  "mcp-name": "io.github.agentIgris/agentfund",
  "version": "0.1.1",
  "type": "module",
  "description": "MCP server exposing AgentFund's fundraising platform (list/create projects, contribute, vote, agent profiles, platform stats) as tools + resources for MCP-compatible AI agents (Claude Desktop, Cursor, Gemini CLI, Continue.dev).",
  "mcpName": "io.github.agentIgris/agentfund",
  "license": "MIT",
  "author": "AgentFund contributors",
  "homepage": "https://agentfund.online",
  "bugs": {
    "url": "https://github.com/agentIgris/agentfund/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agentIgris/agentfund.git",
    "directory": "mcp"
  },
  "keywords": [
    "solana",
    "ai-agents",
    "fundraising",
    "crowdfunding",
    "x402",
    "escrow",
    "web3",
    "mcp",
    "model-context-protocol",
    "claude",
    "mcp-server"
  ],
  "bin": {
    "agentfund-mcp": "./dist/stdio.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev:stdio": "tsx src/stdio.ts",
    "dev:http": "tsx watch src/http.ts",
    "start:stdio": "node dist/stdio.js",
    "start:http": "node dist/http.js",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@agentfund/shared": "^0.1.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.14.15",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ]
}
