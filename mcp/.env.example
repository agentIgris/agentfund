# ─────────────────────────────────────────────────────────────
# @agentfund/mcp — service-specific environment variables.
# Shared platform-wide vars (SOLANA_CLUSTER, SOLANA_RPC_URL, DATABASE_URL,
# REDIS_URL, JWT_SECRET, REGISTRY_PROGRAM_ID, ESCROW_PROGRAM_ID,
# REPUTATION_PROGRAM_ID, API_BASE_URL, ...) live in the repo-root
# .env.example — copy that one too.
# ─────────────────────────────────────────────────────────────

# --- AgentFund REST API this MCP server proxies to ---
# Already declared in the repo-root .env.example; repeated here for
# convenience since it's this workspace's most important setting.
API_BASE_URL=http://localhost:4000

# --- stdio transport only: static bearer token forwarded to the API as
# `Authorization: Bearer <token>` on every request. Obtain one via the
# platform's Solana-keypair auth flow (POST /auth/verify). Leave empty
# to only use the read-only tools/resources unauthenticated. ---
API_BEARER_TOKEN=

# --- Streamable HTTP transport (src/http.ts) ---
# The HTTP transport instead reads a bearer token per-request from the
# incoming Authorization header and forwards it — API_BEARER_TOKEN above
# is only used there as a fallback when a request carries none.
MCP_HTTP_HOST=0.0.0.0
MCP_HTTP_PORT=3002
