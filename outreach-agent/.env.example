# outreach-agent env — copy to .env (gitignored) or export directly.
# Nothing here is required to run in the safe default (dry-run) mode.

# ── LLM provider (leave unset for dry-run: template messages, zero LLM calls) ──
OUTREACH_LLM_BASE_URL=
OUTREACH_LLM_API_KEY=
OUTREACH_LLM_MODEL=gpt-4o-mini

# ── AgentFund API / Solana ──
OUTREACH_API_URL=https://api.agentfund.online
SOLANA_RPC_URL=https://api.devnet.solana.com
REGISTRY_PROGRAM_ID=2TqDeKaadPUeBcgaXXqYAqddfZngUfbq4m8iDSyePSBA

# ── Budget guard ──
OUTREACH_DAILY_TOKEN_BUDGET=5000000
# Defaults to 90% of the budget above if unset.
OUTREACH_DAILY_TOKEN_SOFT_STOP=

# ── Pacing ──
OUTREACH_BATCH_SIZE=10
OUTREACH_MIN_DELAY_MS=1500
OUTREACH_LOOP_INTERVAL_MS=86400000

# ── Local state ──
OUTREACH_DATA_DIR=./outreach-agent/data
OUTREACH_LOG_FILE=./outreach-agent/outreach.log

# Directory holding the three team-owned devnet-agent keypairs. The only
# pubkeys this agent is authorized to actually transact with (E2E testing) —
# every other discovered agent only ever gets a logged draft, never a send.
OUTREACH_OWN_CUSTOMER_AGENTS_DIR=../devnet-agents

# This agent's own devnet identity (register_agent). Generated on first run
# of `npm run register` if the file doesn't exist yet.
OUTREACH_WALLET_PATH=~/.agentfund/outreach-wallet.json

# ── Used only by e2e.ts (authorized E2E test, not the daily loop) ──
# Which devnet-agents/*.json keypair plays the customer in the E2E run.
E2E_AGENT_KEYPAIR_PATH=../devnet-agents/research-agent.json
# Funds the E2E agent's devnet USDC ATA from this wallet's existing balance
# (Circle's devnet USDC faucet is browser/captcha-only and can't be scripted).
DEPLOY_WALLET_PATH=~/.config/solana/id.json
# e2e.ts builds create_project/initialize_escrow instructions directly
# (bypassing a Pinata-dependent API route, see e2e.ts's file header), which
# requires these two in addition to REGISTRY_PROGRAM_ID above. Values below
# are the live devnet deployment's, per DEPLOYMENT.md.
ESCROW_PROGRAM_ID=HiuwNu1K927uTd8xvVCXUHvJW7BcBCgrNBAMC3qUN1Sz
REPUTATION_PROGRAM_ID=7DVKSmmhKVWW5JpwWCS89Fi6uwj3RaPADEBbVqyH8Zo7
