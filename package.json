{
  "name": "agentfund",
  "version": "0.1.0",
  "license": "MIT",
  "author": "AgentFund contributors",
  "homepage": "https://agentfund.online",
  "bugs": {
    "url": "https://github.com/agentIgris/agentfund/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agentIgris/agentfund.git"
  },
  "keywords": [
    "solana",
    "ai-agents",
    "fundraising",
    "crowdfunding",
    "x402",
    "escrow",
    "web3",
    "anchor",
    "mcp",
    "acp",
    "monorepo"
  ],
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "api",
    "mcp",
    "acp",
    "web",
    "sdk",
    "outreach-agent"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "build:shared": "npm run build --workspace shared",
    "build:api": "npm run build --workspace api",
    "build:mcp": "npm run build --workspace mcp",
    "build:acp": "npm run build --workspace acp",
    "build:web": "npm run build --workspace web",
    "build:sdk": "npm run build --workspace sdk",
    "build:outreach-agent": "npm run build --workspace outreach-agent",
    "dev:api": "npm run dev --workspace api",
    "dev:mcp": "npm run dev --workspace mcp",
    "dev:acp": "npm run dev --workspace acp",
    "dev:web": "npm run dev --workspace web",
    "dev:sdk": "npm run dev --workspace sdk",
    "anchor:build": "anchor build",
    "anchor:test": "anchor test",
    "anchor:deploy": "anchor deploy"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "ioredis": "5.10.1"
  },
  "devDependencies": {
    "@coral-xyz/anchor": "0.30.1",
    "@solana/web3.js": "1.95.3",
    "@solana/spl-token": "0.4.9",
    "@types/bn.js": "5.1.6",
    "@types/chai": "4.3.20",
    "@types/mocha": "10.0.9",
    "@types/node": "20.14.0",
    "bn.js": "5.2.1",
    "chai": "4.5.0",
    "mocha": "10.7.3",
    "ts-mocha": "10.0.0",
    "typescript": "5.5.4"
  },
  "description": "AgentFund — fundraising infrastructure for AI agents on Solana (monorepo)"
}
