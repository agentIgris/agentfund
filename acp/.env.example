# ─────────────────────────────────────────────────────────────
# @agentfund/acp — service-specific environment variables.
# Shared platform-wide vars (SOLANA_CLUSTER, SOLANA_RPC_URL, DATABASE_URL,
# REDIS_URL, JWT_SECRET, REGISTRY_PROGRAM_ID, ESCROW_PROGRAM_ID,
# REPUTATION_PROGRAM_ID, API_BASE_URL, ...) live in the repo-root
# .env.example — copy that one too.
# ─────────────────────────────────────────────────────────────

# --- Cluster-agnostic Solana config (used only to label solscan_url with
# ?cluster=devnet when not mainnet-beta; this server never signs or
# broadcasts transactions itself) ---
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com

# --- This server's own bind address/port (spec: acp.agentfund.online, port 3003) ---
ACP_HOST=0.0.0.0
ACP_PORT=3003
LOG_LEVEL=info
CORS_ORIGIN=*

# --- AgentFund REST API this ACP server proxies every agent's execution to ---
# Already declared in the repo-root .env.example; repeated here for
# convenience since it's this workspace's most important setting.
# Defaults to a locally-run api (npm run dev:api). Point this at
# https://api.agentfund.online instead if you're not running api/ yourself.
API_BASE_URL=http://localhost:4000
# Optional override for the WebSocket URL MonitorAgent connects to.
# Defaults to API_BASE_URL with http(s) -> ws(s) and /ws appended, e.g.
# ws://localhost:4000/ws — only set this if the API's WS endpoint lives
# at a different host than its REST endpoint.
API_WS_URL=

# --- Bearer JWT this server presents to the REST API as the platform's
# single "relay agent" identity for actions that require an authenticated
# wallet (FundRaisingAgent's POST /projects, DonationAgent's
# POST /tx/build/contribute). Obtain via GET /auth/challenge +
# POST /auth/verify against the REST API for the relay wallet. Leave
# empty in dev — those two agents will fail with a clear
# "acp_relay_unauthenticated" error until this is set; ProjectEvaluatorAgent
# and MonitorAgent work with this unset (read-only / subscribe-only). ---
ACP_API_TOKEN=

# --- Used to build FundRaisingAgent's project_url ---
FRONTEND_BASE_URL=https://agentfund.online

# --- Used to build *_url fields that point at a block explorer ---
SOLSCAN_BASE_URL=https://solscan.io

# --- In-memory run store (Map + TTL sweep — see src/runs/run-store.ts's
# doc comment for the Redis swap needed to run this horizontally) ---
ACP_RUN_TTL_MS=1800000
ACP_RUN_SWEEP_INTERVAL_MS=60000
ACP_SSE_HEARTBEAT_MS=25000
