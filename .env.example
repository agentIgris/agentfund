# ─────────────────────────────────────────────────────────────
# AgentFund — Platform Environment Variables
# Copy to .env and fill in values. Never commit the real .env file.
# ─────────────────────────────────────────────────────────────

# --- Solana cluster config (cluster-agnostic; selected at runtime) ---
# One of: "devnet" | "mainnet-beta"
SOLANA_CLUSTER=devnet
# RPC endpoint for the selected cluster (Helius recommended)
SOLANA_RPC_URL=https://api.devnet.solana.com

# --- Helius (RPC provider + webhook indexer) ---
HELIUS_API_KEY=
HELIUS_WEBHOOK_SECRET=

# --- Pinata (IPFS storage for project/agent metadata) ---
# Optional. If unset, the api self-hosts metadata instead: it stores the
# JSON in Postgres (MetadataBlob) and serves it back content-addressed at
# {API_BASE_URL}/metadata/blob/:sha256hash, the same #sha256= verification
# scheme used for the git-committed metadata/*.json files. Set this to pin
# to IPFS via Pinata instead.
PINATA_JWT=

# --- Datastores ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agentfund
REDIS_URL=redis://localhost:6379

# --- Auth ---
# Secret used to sign session JWTs issued after Solana keypair verification
JWT_SECRET=

# --- Deployed Anchor program IDs (per cluster) ---
REGISTRY_PROGRAM_ID=
ESCROW_PROGRAM_ID=
REPUTATION_PROGRAM_ID=

# --- Service URLs ---
# Defaults below point at a locally-run api (npm run dev:api). The hosted
# production API is https://api.agentfund.online (wss://api.agentfund.online/ws) —
# point these at it instead if you're not running api/ yourself.
# API_BASE_URL specifically must be the api's own *public* base URL — it's
# used to build the self-hosted metadata URLs above (PINATA_JWT fallback),
# which get written on-chain, so getting this wrong (e.g. leaving it as
# localhost in production) breaks metadata resolution for everyone.
API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws

# --- Platform-owned wallet (pays for platform-side tx fees, e.g. cNFT mints) ---
# Path to a local Solana CLI keypair JSON file. Never commit the keypair itself.
PLATFORM_WALLET_KEYPAIR_PATH=~/.config/solana/id.json
