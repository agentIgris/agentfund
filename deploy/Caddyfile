# TLS is automatic (Let's Encrypt) once api.agentfund.online resolves here.
# reverse_proxy handles WebSocket upgrades natively.
api.agentfund.online {
	encode gzip
	reverse_proxy api:4000
}

mcp.agentfund.online {
	encode gzip
	reverse_proxy mcp:3002
}

acp.agentfund.online {
	encode gzip
	reverse_proxy acp:3003
}
