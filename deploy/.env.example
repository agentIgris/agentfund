# deploy/.env — server-only runtime secrets. Copy to the host and fill in.
# NEVER commit the filled-in version.

# Postgres superuser password for the compose stack (also composed into
# DATABASE_URL inside docker-compose.prod.yml).
POSTGRES_PASSWORD=

# Auth / webhook signing
JWT_SECRET=
WEBHOOK_SIGNING_SECRET=

# api's own public base URL. Required correct in production: it's used to
# build metadata URLs when self-hosting project/agent metadata (see
# PINATA_JWT below), and those URLs get written on-chain — pointing this at
# localhost/an internal address breaks metadata resolution for everyone.
API_BASE_URL=https://api.agentfund.online

# Pinata (IPFS pinning for project/agent metadata). Optional — if unset,
# the api self-hosts metadata in Postgres instead (served content-addressed
# at API_BASE_URL/metadata/blob/:hash). Set this to pin to IPFS instead.
PINATA_JWT=

# Solana (devnet)
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=
HELIUS_API_KEY=
HELIUS_WEBHOOK_SECRET=
REGISTRY_PROGRAM_ID=2TqDeKaadPUeBcgaXXqYAqddfZngUfbq4m8iDSyePSBA
ESCROW_PROGRAM_ID=HiuwNu1K927uTd8xvVCXUHvJW7BcBCgrNBAMC3qUN1Sz
REPUTATION_PROGRAM_ID=7DVKSmmhKVWW5JpwWCS89Fi6uwj3RaPADEBbVqyH8Zo7

# Network label stamped into x402 settlement receipts (X-PAYMENT-RESPONSE).
# Defaults to solana-localnet in code — must be set explicitly in production.
X402_NETWORK=solana-devnet

# Optional SVS action gate for x402 contributions. Keep false until the
# dedicated relayer credential and delegated donor-agent IDs are configured.
SVS_X402_ENFORCE=false
SVS_SERVER_URL=https://app.svsprotocol.com
SVS_RELAYER_BOT_ID=agentfund-relayer
SVS_RELAYER_API_KEY=
SVS_RELAYER_REQUEST_SIGNING_SECRET=
SVS_X402_POLICY_ID=agentfund-x402-contribution-v1
SVS_X402_APPROVAL_STALE_AFTER_MS=900000
SVS_CERTIFICATION_STALE_AFTER_MS=86400000

# 402 Index (402index.io) domain-ownership proof. Set to the verification_hash
# returned by POST https://402index.io/api/v1/claim, served verbatim at
# GET /.well-known/402index-verify.txt. Account-bound to whoever claims the
# domain — not committed to git.
INDEX_402_VERIFICATION_HASH=

# CORS / logging
CORS_ORIGIN=*
LOG_LEVEL=info
